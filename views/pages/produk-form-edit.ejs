<%- include('../partials/header', { pageTitle: pageTitle }) %>

<div class="card" style="margin-top: 1.5rem;">
    <h2>Edit Produk</h2>

    <form action="/produk/edit/<%= produk.id %>" method="POST">

        <div style="margin-bottom: 1rem;">
            <label for="nama_produk">Nama Produk</label>
            <input
                type="text"
                id="nama_produk"
                name="nama_produk"
                value="<%= produk.nama_produk %>"
                required
                style="width: 100%; padding: 0.5rem;"
            >
        </div>

        <div style="margin-bottom: 1rem;">
            <label for="kategori">Kategori</label>
            <input
                type="text"
                id="kategori"
                name="kategori"
                value="<%= produk.kategori %>"
                required
                style="width: 100%; padding: 0.5rem;"
            >
        </div>

        <div style="margin-bottom: 1rem;">
            <label for="harga">Harga (Rp)</label>
            <input
                type="number"
                id="harga"
                name="harga"
                value="<%= produk.harga %>"
                min="0"
                required
                style="width: 100%; padding: 0.5rem;"
            >
        </div>

        <div style="margin-bottom: 1rem;">
            <label for="stok">Stok</label>
            <input
                type="number"
                id="stok"
                name="stok"
                value="<%= produk.stok %>"
                min="0"
                required
                style="width: 100%; padding: 0.5rem;"
            >
        </div>

        <button
            type="submit"
            style="padding: 0.6rem 1rem; background: #0284c7; color: white; border: none; border-radius: 4px; cursor: pointer;"
        >
            Simpan Perubahan
        </button>

        <a
            href="/produk"
            style="margin-left: 0.5rem; text-decoration: none;"
        >
            Batal
        </a>

    </form>
</div>

<%- include('../partials/footer') %>